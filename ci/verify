#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
mode="${1:---fast}"
stage=""
repro=""
trap 'status=$?; if [ "$status" -ne 0 ]; then echo "ci verify: FAIL at $stage; reproduce with: $repro"; fi' EXIT

stage() {
  stage="$1"
  repro="$2"
  shift 2
  echo "ci/verify: $stage"
  "$@"
}

required_files() {
  for f in LICENSE NOTICE README.md CITATION.cff docs/PLAN.md .coderabbit.yaml; do
    test -s "$f" || { echo "missing $f"; return 1; }
  done
  grep -q "Apache License" LICENSE
  grep -q "Shaderzx/delphi" NOTICE
}

link_targets() {
  local inline reference
  inline="$(grep -oE '\]\([^)]+\)' "$1")" || [ $? -eq 1 ]
  reference="$(grep -oE '^ {0,3}\[[^]]+\]:[[:space:]]*[^[:space:]]+' "$1")" || [ $? -eq 1 ]
  {
    printf '%s\n' "$inline" | sed -E 's/^\]\((.*)\)$/\1/'
    printf '%s\n' "$reference" | sed -E 's/^ {0,3}\[[^]]+\]:[[:space:]]*//'
  } | awk 'NF { print $1 }' | sed -E 's/^<(.*)>$/\1/'
}

relative_links() {
  local files md targets target path broken=0
  files="$(git ls-files '*.md')"
  [ -n "$files" ] || { echo "no tracked markdown files"; return 1; }
  while IFS= read -r md; do
    targets="$(link_targets "$md")"
    while IFS= read -r target; do
      case "$target" in ''|http:*|https:*|mailto:*|'#'*) continue ;; esac
      path="${target%%#*}"
      [ -e "$(dirname "$md")/$path" ] || { echo "$md -> $target"; broken=1; }
    done <<< "$targets"
  done <<< "$files"
  return "$broken"
}

python_with_requirements() {
  local venv=".venv"
  [ -x "$venv/bin/python" ] || python3 -m venv "$venv"
  "$venv/bin/pip" install --quiet -r drafter/requirements.txt
}

e2e_suite() {
  (cd e2e && npm ci --silent && DELPHI_PYTHON="$PWD/../.venv/bin/python" npx e2e run)
}

stage required-files "ci/verify --fast" required_files
stage relative-links "ci/verify --fast" relative_links
done_stages="required-files,relative-links"
if [ "$mode" = "--full" ]; then
  stage python-requirements "ci/verify --full" python_with_requirements
  stage e2e "ci/verify --full" e2e_suite
  stage landmines "node ci/landmines/landmines.mjs --base ${CI_VERIFY_BASE:-origin/main}" node ci/landmines/landmines.mjs --base "${CI_VERIFY_BASE:-origin/main}"
  done_stages="$done_stages,python-requirements,e2e,landmines"
fi
stage=""
echo "ci verify: PASS ($done_stages)"